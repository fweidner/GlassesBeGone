---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description?: string;
}

const { title, description = 'A map and archive of real-world smart glasses bans, sourced from news coverage.' } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
  </head>
  <body>
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>

<style is:global>
  :root {
    color-scheme: light dark;
    --bg: #ffffff;
    --fg: #1a1a1a;
    --muted: #6b7280;
    --border: #e5e7eb;
    --accent: #2563eb;
    --card-bg: #f9fafb;
  }

  @media (prefers-color-scheme: dark) {
    :root {
      --bg: #111214;
      --fg: #f2f2f2;
      --muted: #9ca3af;
      --border: #2a2b2f;
      --accent: #60a5fa;
      --card-bg: #1a1b1e;
    }
  }

  * {
    box-sizing: border-box;
  }

  body {
    margin: 0;
    background: var(--bg);
    color: var(--fg);
    font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
    line-height: 1.5;
  }

  main {
    max-width: 960px;
    margin: 0 auto;
    padding: 1.5rem 1rem 3rem;
  }

  a {
    color: var(--accent);
  }

  h1 {
    font-size: 1.9rem;
    margin-bottom: 0.5rem;
  }

  .card-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
    align-items: start;
    gap: 1rem;
    margin-top: 1rem;
  }

  .entry-card {
    display: block;
    border: 1px solid var(--border);
    border-radius: 10px;
    padding: 1rem;
    background: var(--card-bg);
    text-decoration: none;
    color: inherit;
  }

  .entry-card:hover {
    border-color: var(--accent);
  }

  .entry-card h3 {
    margin: 0.4rem 0 0.2rem;
    font-size: 1.05rem;
  }

  .entry-card .address {
    color: var(--muted);
    font-size: 0.85rem;
    margin: 0;
  }

  .badge {
    display: inline-block;
    font-size: 0.7rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.03em;
    padding: 0.15rem 0.5rem;
    border-radius: 999px;
    color: white;
  }
</style>
